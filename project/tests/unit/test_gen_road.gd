extends TestCase
## Stages 4 and 5 (WP13b, core/gen/gen_road.gd): The Old Road (`road`) and Crossroads Inn (`inn`), 50 seeds each against the rules in
## docs/ROGUELIKE.md: outdoor kind, >= 3 covered pockets (>= 2 rest spots) the sun cannot reach, cover distance, the open-air rule (R = 5), caps, doors linked
## both ways with the neighbouring stages, people on walkable cells, the shrine's holy ground (it drains blood in a TrekFlow), determinism, generation time.

const SEEDS := 50
const STAGES := ["road", "inn"]
const OPEN_R := 5.0

static var _defs: Dictionary = {}
static var _ms: Dictionary = {}


func _all(id: String) -> Array:
	if not _defs.has(id):
		var a: Array = []
		var m: Array = []
		for s in range(1, SEEDS + 1):
			var t0 := Time.get_ticks_usec()
			a.append(StageGen.generate(id, s))
			m.append(float(Time.get_ticks_usec() - t0) / 1000.0)
		_defs[id] = a
		_ms[id] = m
	return _defs[id]


func _row(id: String) -> Dictionary:
	return StageGen.stage_row(id)


func _zone(def: Dictionary, name: String) -> Dictionary:
	for z in def["zones"]:
		if z["name"] == name:
			return z
	return {}


func _in_zone(z: Dictionary, c: Array) -> bool:
	return c[0] >= z["x0"] and c[0] <= z["x1"] and c[1] >= z["y0"] and c[1] <= z["y1"]


func _stub(name: String, door_id: String, to_map: String, to_door: String) -> Dictionary:
	return {"name": name, "kind": "outdoor", "floor": "grass", "rows": ["#####", "#@..#", "#..D#", "#####"],
		"doors": [{"id": door_id, "col": 3, "row": 2, "toMap": to_map, "toDoor": to_door, "facing": "w"}]}


func _neighbours(id: String, d: Dictionary) -> Dictionary:
	var maps := {d["name"]: d}
	if id == "road":
		maps["stage:moor"] = _stub("stage:moor", "road", d["name"], "moor")
		maps["stage:inn"] = _stub("stage:inn", "road", d["name"], "inn")
	else:
		maps["stage:road"] = _stub("stage:road", "inn", d["name"], "road")
		maps["stage:hamlet"] = _stub("stage:hamlet", "inn", d["name"], "hamlet")
	return maps


func test_rows() -> void:
	var order := TrekFlow.stage_order()
	for id in STAGES:
		var r := _row(id)
		ok(not r.is_empty(), id + " row in stages.json")
		eq(r["generator"], id, id + " generator")
		eq(r["kind"], "outdoor", id + " kind")
		eq(String(r["next"]), order[order.find(id) + 1], id + " next stage follows the order list")
		eq(TrekFlow.next_stage_id(id), String(r["next"]), id + " TrekFlow.next_stage_id")
		eq(int(r["index"]), order.find(id) + 1, id + " index")
		ok(TrekFlow.has_generator(id), id + " is generated by TrekFlow")
		eq(String(r["entry"]["toMap"]), "stage:" + String(order[order.find(id) - 1]), id + " entry links to the previous stage")
		eq(String(r["exit"]["toMap"]), "stage:" + String(r["next"]), id + " exit links to the next stage")
		for k in ["preyCount", "lights", "size", "openFraction", "shelter", "caps", "entry", "exit", "materials"]:
			ok(r.has(k), id + " row key " + k)
		eq(int(r["shelter"]["pockets"]["min"]), 3, id + " min pockets")
		eq(int(r["shelter"]["restSpots"]["min"]), 2, id + " min rest spots")
	eq(int(_row("road")["miles"]), 4, "road miles")
	eq(int(_row("inn")["miles"]), 3, "inn miles")
	near(float(_row("road")["drainMul"]), 1.1, 1e-9, "road drainMul")
	near(float(_row("inn")["drainMul"]), 1.1, 1e-9, "inn drainMul")
	eq(int(_row("road")["caps"]["people"]), 10, "road people cap")
	eq(int(_row("inn")["caps"]["people"]), 8, "inn people cap")
	eq(String(_row("moor")["exit"]["toDoor"]), String(_row("road")["entry"]["doorId"]), "moor exit leads to the road's moor door")
	eq(String(_row("road")["exit"]["toDoor"]), String(_row("inn")["entry"]["doorId"]), "road exit leads to the inn's road door")
	eq(String(_row("road")["entry"]["toDoor"]), String(_row("moor")["exit"]["doorId"]), "road entry points back at the moor's road door")
	ok(not TrekFlow.has_generator("hamlet"), "the hamlet is not built yet (frontier after the inn)")


func test_seeds_validate_and_reach() -> void:
	for id in STAGES:
		var defs := _all(id)
		eq(defs.size(), SEEDS, id + " all seeds generated")
		var row := _row(id)
		for i in defs.size():
			var d: Dictionary = defs[i]
			var tag := "%s seed %d" % [id, i + 1]
			ok(not d.is_empty(), tag + " generated")
			if d.is_empty():
				continue
			var v := StageGen.validate(d)
			ok(v["ok"], tag + " validate: " + str(v["errors"]).left(160))
			var va := WorldValidate.validate_all({"startMap": d["name"], "maps": _neighbours(id, d), "links": []})
			ok(va["ok"], tag + " validate_all with neighbours: " + str(va["errors"]).left(200))
			var rep := StageGen.analyze(d, row)
			ok(rep["ok"], tag + " analyze: " + str(rep["reasons"]))
			ok(rep["exit_reachable"], tag + " exit reachable from the start")
			eq(rep["unreachable"], 0, tag + " no cut-off floor")
			eq(d["rows"].size(), 48, tag + " height")
			eq(String(d["rows"][0]).length(), 64, tag + " width")
			eq(d["stage"], id, tag + " stage id")
			eq(d["seed"], i + 1, tag + " seed echoed")
			eq(d["kind"], "outdoor", tag + " outdoor map")
			# the exit is reachable for the real World too (solid props, closed door cells)
			var world := World.from_def(d)
			var arr: Variant = world.arrival(d["doors"][1]["id"])
			ok(arr != null and not world.blocks(arr["x"], arr["y"], 0.25), tag + " exit arrival is open")


func test_doors_both_ways() -> void:
	for id in STAGES:
		var row := _row(id)
		for i in _all(id).size():
			var d: Dictionary = _all(id)[i]
			var tag := "%s seed %d" % [id, i + 1]
			eq(d["doors"].size(), 2, tag + " two doors")
			var entry: Dictionary = d["doors"][0]
			var exit_d: Dictionary = d["doors"][1]
			eq(entry["id"], row["entry"]["doorId"], tag + " entry door id")
			eq(entry["toMap"], row["entry"]["toMap"], tag + " entry toMap")
			eq(entry["toDoor"], row["entry"]["toDoor"], tag + " entry toDoor")
			eq(entry["facing"], "e", tag + " entry faces east")
			eq(exit_d["id"], row["exit"]["doorId"], tag + " exit door id")
			eq(exit_d["toMap"], row["exit"]["toMap"], tag + " exit toMap")
			eq(exit_d["toDoor"], row["exit"]["toDoor"], tag + " exit toDoor")
			eq(exit_d["facing"], "w", tag + " exit faces west")
			eq(String(d["rows"][entry["row"]])[entry["col"]], "D", tag + " entry door cell")
			eq(String(d["rows"][exit_d["row"]])[exit_d["col"]], "D", tag + " exit door cell")
			ok(exit_d["col"] > 48 and entry["col"] < 8, tag + " door on each far edge")
			var st: Array = d["start"]["cell"]
			eq(st, d["entry"]["arrival"], tag + " start is the entry door's arrival cell")
			eq(String(d["rows"][st[1]])[st[0]], "@", tag + " start marker")
			near(float(d["start"]["angle"]), 0.0, 1e-9, tag + " facing east")
			eq(d["exit"]["door"], exit_d["id"], tag + " exit key")


## Pockets: indoor zones, every rest one a roofed `S`; the sun's rule (day + outdoor = lost) cannot reach them.
func test_pockets_and_sun() -> void:
	var worst_pockets := 99
	for id in STAGES:
		var row := _row(id)
		var kinds: Array = row["shelter"]["safety"].keys()
		for i in _all(id).size():
			var d: Dictionary = _all(id)[i]
			var tag := "%s seed %d" % [id, i + 1]
			var world := World.from_def(d)
			worst_pockets = mini(worst_pockets, d["pockets"].size())
			ok(d["pockets"].size() >= 3, tag + " >= 3 covered pockets (%d)" % d["pockets"].size())
			var s_count := 0
			for ch in "\n".join(d["rows"]):
				if ch == "S":
					s_count += 1
				elif ch == "C":
					ok(false, tag + " no coffin marker expected")
			ok(d["rest"].size() >= 2, tag + " >= 2 rest spots")
			for r in d["rest"]:
				ok(kinds.has(r["kind"]), tag + " rest kind " + String(r["kind"]))
				ok(float(r["safety"]) >= 0.0 and float(r["safety"]) <= 1.0, tag + " safety in 0..1")
				eq(String(d["rows"][r["cell"][1]])[r["cell"][0]], r["marker"], tag + " rest marker on the map")
				eq(world.kind_at(r["cell"][0] + 0.5, r["cell"][1] + 0.5), "indoor", tag + " rest spot is roofed")
				if id == "road":
					ok(float(r["safety"]) <= 0.6, tag + " road rest safety %.2f is lower than the wild stages" % float(r["safety"]))
			eq(s_count, d["rest"].size(), tag + " one S per rest spot")
			var names := {}
			for z in d["zones"]:
				ok(["indoor", "holy"].has(z["kind"]), tag + " zone kind " + String(z["kind"]))
				ok(not names.has(z["name"]), tag + " unique zone " + z["name"])
				names[z["name"]] = true
			var rest_pockets := 0
			for p in d["pockets"]:
				var z := _zone(d, p["zone"])
				ok(not z.is_empty() and z["kind"] == "indoor", tag + " pocket zone " + p["zone"])
				if not z.is_empty():
					ok(_in_zone(z, p["cell"]), tag + " pocket cell inside its zone")
					for y in range(z["y0"], z["y1"] + 1):
						for x in range(z["x0"], z["x1"] + 1):
							if ".,gSP@".contains(String(d["rows"][y])[x]):
								eq(world.kind_at(x + 0.5, y + 0.5), "indoor", tag + " pocket floor is indoor")
				if p["rest"]:
					rest_pockets += 1
			ok(rest_pockets >= 2, tag + " pockets that are rest spots")
			var pc: Array = d["rest"][0]["cell"]
			var n1 := Night.create({"nightSec": 480.0})
			n1.status = "day"
			n1.min = Night.NIGHT_MIN
			n1.fired = {"chime": true, "washout": true, "dawn": true}
			var ev1 := n1.update(0.1, {"outdoor": world.kind_at(pc[0] + 0.5, pc[1] + 0.5) == "outdoor"})
			eq(n1.status, "day", tag + " alive at dawn inside a pocket")
			ok(not ev1.has("lost"), tag + " no sun death in a pocket")
			var st: Array = d["start"]["cell"]
			var n2 := Night.create({"nightSec": 480.0})
			n2.status = "day"
			n2.min = Night.NIGHT_MIN
			n2.fired = {"chime": true, "washout": true, "dawn": true}
			n2.update(0.1, {"outdoor": world.kind_at(st[0] + 0.5, st[1] + 0.5) == "outdoor"})
			eq(n2.status, "lost", tag + " the open start cell is sunlit")
	print("gen_road: fewest pockets over %d seeds x 2 stages = %d" % [SEEDS, worst_pockets])


func test_cover_distance_rule() -> void:
	var limit := StageGen.cover_limit()
	for id in STAGES:
		var row := _row(id)
		var target: int = int(row["shelter"]["restTarget"])
		var worst := 0
		for i in _all(id).size():
			var rep := StageGen.analyze(_all(id)[i], row)
			worst = maxi(worst, rep["max_rest_dist"])
			ok(rep["max_rest_dist"] >= 0 and rep["max_rest_dist"] <= limit, "%s seed %d rest within %d cells (got %d)" % [id, i + 1, limit, rep["max_rest_dist"]])
			ok(rep["max_rest_dist"] <= target + 10, "%s seed %d design target %d (got %d)" % [id, i + 1, target, rep["max_rest_dist"]])
		print("gen_road: %s worst rest distance over %d seeds = %d cells (rule limit %d, design target %d)" % [id, SEEDS, worst, limit, target])


## Open-air rule (docs: road R = 5): every walkable cell has a wall cell within 5 cells.
func test_open_air_rule() -> void:
	for id in STAGES:
		var worst := 0.0
		for i in _all(id).size():
			var oa := GenRoad.open_air_max(_all(id)[i])
			worst = maxf(worst, oa)
			ok(oa <= OPEN_R, "%s seed %d: farthest walkable cell is %.2f from a wall (limit %.1f)" % [id, i + 1, oa, OPEN_R])
		print("gen_road: %s open-air worst distance over %d seeds = %.2f cells (limit %.1f)" % [id, SEEDS, worst, OPEN_R])
	var rows: Array = []
	for y in 20:
		rows.append("#".repeat(20) if (y == 0 or y == 19) else "#" + ".".repeat(18) + "#")
	ok(GenRoad.open_air_max({"rows": rows}) > 8.0, "open_air_max sees the middle of a big room")


func test_caps_and_fractions() -> void:
	var species := Critters.species_table()
	for id in STAGES:
		var row := _row(id)
		var lo := 1.0
		var hi := 0.0
		for i in _all(id).size():
			var d: Dictionary = _all(id)[i]
			var tag := "%s seed %d" % [id, i + 1]
			var plan := StageGen.plan_from_def(d)
			ok(d["paths"].size() <= int(row["caps"]["people"]), tag + " people <= cap (%d)" % d["paths"].size())
			ok(d["critters"].size() <= 12, tag + " critters <= 12")
			for c in d["critters"]:
				ok(species.has(c["species"]), tag + " known species " + str(c["species"]))
				ok(plan.walkable(c["cell"][0], c["cell"][1]), tag + " critter on walkable floor")
			ok(d["props"].size() <= 60, tag + " props <= 60")
			ok(d["lights"].size() <= 16, tag + " lights <= 16")
			ok(d["lights"].size() >= int(row["lights"]["min"]) and d["lights"].size() <= int(row["lights"]["max"]), tag + " light count %d" % d["lights"].size())
			ok(d["ambient"].size() <= 24, tag + " ambient anchors <= 24")
			var f: float = StageGen.analyze(d, row)["open_fraction"]
			lo = minf(lo, f)
			hi = maxf(hi, f)
			ok(f >= float(row["openFraction"]["min"]) and f <= float(row["openFraction"]["max"]), tag + " open fraction %.3f" % f)
			var world := World.from_def(d)
			eq(world.kind, "outdoor", tag + " world kind outdoor")
			ok(world.has_water, tag + " water present")
			for p in d["props"]:
				ok(plan.tile(p["col"], p["row"]) == 1, tag + " prop on floor")
		print("gen_road: %s open fraction over %d seeds %.3f .. %.3f" % [id, SEEDS, lo, hi])


func _count(d: Dictionary, ch: String) -> int:
	return "\n".join(d["rows"]).count(ch)


func _anchor_kinds(d: Dictionary) -> Dictionary:
	var k := {}
	for a in d["ambient"]:
		k[a["kind"]] = int(k.get(a["kind"], 0)) + 1
	return k


func test_road_features() -> void:
	var kinds_seen := {}
	for i in _all("road").size():
		var d: Dictionary = _all("road")[i]
		var tag := "road seed %d" % (i + 1)
		ok(_count(d, "I") >= 6, tag + " fence posts (%d)" % _count(d, "I"))
		ok(_count(d, "B") >= 3, tag + " milestones and crypt stone (%d)" % _count(d, "B"))
		ok(_count(d, "~") >= 3, tag + " ditch water")
		ok(_count(d, ".") >= 100, tag + " cobbles")
		eq(d["floor"], "cobble", tag + " cobble floor")
		eq(d["materials"]["#"], "grass", tag + " hedge material")
		eq(d["materials"]["B"], "stone", tag + " milestone material")
		eq(d["paths"].size() >= 4 and d["paths"].size() <= 10, true, tag + " travellers (%d)" % d["paths"].size())
		var kinds := _anchor_kinds(d)
		ok(kinds.get("cart", 0) >= 2, tag + " cart rumble")
		eq(kinds.get("bell", 0), 1, tag + " shrine bell")
		ok(kinds.get("wind", 0) >= 2 and kinds.get("cricket", 0) >= 3, tag + " wind and crickets " + str(kinds))
		for p in d["pockets"]:
			ok(["wayside_crypt", "culvert", "bramble_hollow"].has(p["kind"]), tag + " road pocket kind " + String(p["kind"]))
			kinds_seen[p["kind"]] = true
		var crows := 0
		for c in d["critters"]:
			ok(c["species"] == "crow" or c["species"] == "hare", tag + " road fauna")
			if c["species"] == "crow":
				crows += 1
		ok(crows >= 3, tag + " crows %d" % crows)
		var guards := 0
		var pilgrims := 0
		for pd in d["paths"]:
			if pd["archetype"] == "guard":
				guards += 1
			elif pd["archetype"] == "patron":
				pilgrims += 1
			ok(pd["points"].size() >= 3, tag + " a walking path")
		eq(guards, 2, tag + " two watchers")
		eq(pilgrims, 2, tag + " a pilgrim pair")
		# the road itself winds the whole way: a cobbled column in every x between the doors
		var rows: Array = d["rows"]
		var cob := 0
		for x in range(4, 60):
			var has := false
			for y in rows.size():
				if String(rows[y])[x] == ".":
					has = true
			if has:
				cob += 1
		ok(cob >= 54, tag + " road runs door to door (%d of 56 columns)" % cob)
	ok(kinds_seen.size() >= 2, "several pocket kinds over 50 seeds " + str(kinds_seen.keys()))


func test_shrine_holy_ground() -> void:
	for i in _all("road").size():
		var d: Dictionary = _all("road")[i]
		var tag := "road seed %d" % (i + 1)
		var shr: Array = []
		for p in d["props"]:
			if p["type"] == "shrine":
				shr.append(p)
		eq(shr.size(), 1, tag + " one shrine")
		var s: Dictionary = shr[0]
		var z := _zone(d, "shrine_holy")
		ok(not z.is_empty(), tag + " holy zone")
		eq(z["kind"], "holy", tag + " zone kind")
		eq([z["x1"] - z["x0"] + 1, z["y1"] - z["y0"] + 1], [3, 3], tag + " 3x3")
		ok(_in_zone(z, [s["col"], s["row"]]) and z["x0"] + 1 == s["col"] and z["y0"] + 1 == s["row"], tag + " centred on the shrine")
		var world := World.from_def(d)
		eq(world.kind_at(s["col"] + 1.5, s["row"] + 0.5), "holy", tag + " holy beside the shrine")
		ok(world.kind_at(s["col"] + 2.5, s["row"] + 0.5) != "holy", tag + " the ring around the zone is not holy")
		ok(world.blocks(s["col"] + 0.5, s["row"] + 0.5, 0.25), tag + " the shrine is solid")
		var walk_holy := 0
		for y in range(z["y0"], z["y1"] + 1):
			for x in range(z["x0"], z["x1"] + 1):
				if ".,gSP@".contains(String(d["rows"][y])[x]):
					walk_holy += 1
		eq(walk_holy, 9, tag + " nine floor cells, one of them the solid shrine")
		var kinds := _anchor_kinds(d)
		ok(kinds.get("bell", 0) == 1, tag + " bell")
		var bell: Array = []
		for a in d["ambient"]:
			if a["kind"] == "bell":
				bell = a["cell"]
		ok(absi(bell[0] - s["col"]) + absi(bell[1] - s["row"]) <= 3, tag + " bell by the shrine")
		ok(not world.blocks(bell[0] + 0.5, bell[1] + 0.5, 0.25) and world.kind_at(bell[0] + 0.5, bell[1] + 0.5) != "holy", tag + " bell anchor on safe floor")


## A trek on the road: blood drains at the holy rule beside the shrine and not elsewhere; the holy cell is no sun death.
func test_holy_drains_in_trek_flow() -> void:
	var f := TrekFlow.begin(TrekMeta.create(), 11)
	for _l in 3:
		var r := f.reach_exit()
		ok(r["ok"] and not r["ended"], "walked to the next stage")
	eq(f.stage_id, "road", "on the road")
	var shrine: Array = f.def["places"]["shrine"]
	var hc := Vector2i(int(shrine[0]) + 1, int(shrine[1]))
	var hp := Vector2(hc.x + 0.5, hc.y + 0.5)
	eq(f.world.kind_at(hp.x, hp.y), "holy", "the cell beside the shrine is holy")
	var b0 := f.night.blood
	var ev := f.step(1.0, hc, f.cell_outdoor(hc), {"player_pos": hp})
	var lost := b0 - f.night.blood
	ok(lost > TrekFlow.HOLY_DPS - 0.1 and lost < TrekFlow.HOLY_DPS + 1.0, "holy ground drains %.2f blood in one second" % lost)
	var holy_ev := false
	for e in ev:
		if e["type"] == "holy":
			holy_ev = true
	ok(holy_ev, "holy event")
	# the open road: only the normal drain
	var oc: Vector2i = f.start_cell
	var op := Vector2(oc.x + 0.5, oc.y + 0.5)
	var b1 := f.night.blood
	f.step(1.0, oc, f.cell_outdoor(oc), {"player_pos": op})
	ok(b1 - f.night.blood < 1.0, "no holy drain on the road (%.2f)" % (b1 - f.night.blood))
	# staying on holy ground is fatal
	f.update_position(hc, hp)
	var died := false
	for _s in 40:
		for e in f.step(0.5, hc, f.cell_outdoor(hc), {"player_pos": hp}):
			if e["type"] == "death":
				died = true
	ok(died and f.cause == "holy", "staying beside the shrine is the holy death")


func _spawned(d: Dictionary, seed_: int) -> People:
	var w := World.from_def(d)
	return People.create(w, d, {"seed": seed_})


## People spawn from the P markers (row-major) with the path defs; every spawn is on walkable floor and every walker keeps its path.
func test_people_spawn() -> void:
	for id in STAGES:
		var total := 0
		for i in _all(id).size():
			var d: Dictionary = _all(id)[i]
			var tag := "%s seed %d" % [id, i + 1]
			var w := World.from_def(d)
			eq(w.spots["people"].size(), d["paths"].size(), tag + " one P marker per path")
			var last := -1
			for p in w.spots["people"]:
				var k: int = int(floor(p.y)) * 64 + int(floor(p.x))
				ok(k > last, tag + " P markers row-major")
				last = k
			for k in d["paths"].size():
				var pd: Dictionary = d["paths"][k]
				ok(absf(float(pd["points"][0][0]) + 0.5 - w.spots["people"][k].x) < 1e-9 and absf(float(pd["points"][0][1]) + 0.5 - w.spots["people"][k].y) < 1e-9, tag + " path %d starts on its P marker" % k)
			var st := _spawned(d, 3)
			eq(st.people.size(), d["paths"].size(), tag + " people spawned")
			total += st.people.size()
			for k in st.people.size():
				var p = st.people[k]
				ok(not w.blocks(p.x, p.y, 0.25), tag + " person %d on walkable floor" % k)
				ok(w.kind_at(p.x, p.y) != "holy", tag + " person %d not on holy ground" % k)
				var pd2: Dictionary = d["paths"][k]
				eq(p.path.size(), pd2["points"].size(), tag + " person %d kept its path (%s)" % [k, pd2["archetype"]])
				eq(p.sit, pd2.get("sit", false) == true, tag + " person %d sit flag" % k)
		ok(total >= 4, id + " people exist")


func test_inn_features() -> void:
	for i in _all("inn").size():
		var d: Dictionary = _all("inn")[i]
		var tag := "inn seed %d" % (i + 1)
		ok(_count(d, "W") >= 100, tag + " timber walls")
		ok(_count(d, ",") >= 150, tag + " wood floor")
		ok(_count(d, "w") >= 3, tag + " windows")
		eq(d["materials"]["W"], "wood", tag + " timber material")
		for zn in ["tavern", "cellar", "kitchen", "stable", "woodshed"]:
			ok(not _zone(d, zn).is_empty(), tag + " zone " + zn)
		var cellar: Dictionary = {}
		var stable := false
		var shed := false
		for r in d["rest"]:
			if r["kind"] == "cellar":
				cellar = r
			elif r["kind"] == "stable":
				stable = true
			elif r["kind"] == "woodshed":
				shed = true
		ok(not cellar.is_empty() and stable and shed, tag + " cellar, stable and woodshed rest spots")
		ok(float(cellar["safety"]) <= 0.45, tag + " the cellar is unsafe (%.2f)" % float(cellar["safety"]))
		ok(_in_zone(_zone(d, "cellar"), cellar["cell"]), tag + " the cellar spot is in the cellar zone")
		var kinds := _anchor_kinds(d)
		ok(kinds.get("hearth", 0) >= 2 and kinds.get("singing", 0) >= 1, tag + " hearth and singing " + str(kinds))
		ok(d["lights"].size() >= 6, tag + " a lit common room (%d lights)" % d["lights"].size())
		var lit := 0
		var tav := _zone(d, "tavern")
		for l in d["lights"]:
			if _in_zone(tav, l["cell"]):
				lit += 1
		ok(lit >= 4, tag + " lights in the common room (%d)" % lit)
		var arche := {}
		var seated := 0
		var sched_roles := 0
		for pd in d["paths"]:
			arche[pd["archetype"]] = int(arche.get(pd["archetype"], 0)) + 1
			if pd.get("sit", false) == true:
				seated += 1
			elif pd.get("home") == "tavern":
				sched_roles += 1
		ok(d["paths"].size() >= 7 and d["paths"].size() <= 8, tag + " patrons %d" % d["paths"].size())
		ok(arche.has("innkeeper") and arche.has("drunk") and arche.get("regular", 0) == 2 and arche.has("merchant"), tag + " patron mix " + str(arche))
		eq(seated, 3, tag + " three seated patrons")
		ok(sched_roles >= 5, tag + " scheduled patrons")
		for k in ["tavern_a", "tavern_b", "tavern_c", "tavern_t", "tavern_hearth", "tavern_bed", "square"]:
			ok(d["places"].has(k), tag + " place " + k)
		# the schedule builds for the innkeeper and the regulars
		var st := _spawned(d, 5)
		var with_sched := 0
		for p in st.people:
			if p.sched != null:
				with_sched += 1
		ok(with_sched >= 4, tag + " people with a schedule (%d)" % with_sched)
		var haybales := 0
		for p in d["props"]:
			if p["type"] == "haybale":
				haybales += 1
		ok(haybales >= 2, tag + " stable hay")
		for c in d["critters"]:
			eq(c["species"], "rat", tag + " only rats")
		var tx: Array = d["start"]["cell"]
		ok(String(d["rows"][tx[1]])[tx[0]] == "@", tag + " start")
	# the yard and the building are separate: every seed's exit lies across the yard from the entry
	for d2 in _all("inn"):
		ok(d2["exit"]["arrival"][0] - d2["start"]["cell"][0] >= 50, "inn exit on the far side of the yard")


func test_deterministic_and_distinct() -> void:
	for id in STAGES:
		var defs := _all(id)
		for s in [1, 17, 50]:
			var again := StageGen.generate(id, s)
			ok(again == defs[s - 1], "%s seed %d regenerates identically" % [id, s])
		var seen := {}
		for d in defs:
			seen[str(d["rows"]).hash()] = true
		eq(seen.size(), defs.size(), id + " all 50 seeds give different maps")
		var other := StageGen.generate(id, 1000003)
		ok(other["rows"] != defs[0]["rows"], id + " far seed differs")
	ok(_all("road")[0]["rows"] != _all("inn")[0]["rows"], "the two stages differ")


func test_register_and_build_world() -> void:
	for id in STAGES:
		var d: Dictionary = _all(id)[2]
		GameData.register_map(id + "_gen_test", d)
		var def: Dictionary = GameData.map_def(id + "_gen_test")
		var w := World.from_def(def)
		eq(w.width, 64, id + " world width")
		eq(w.height, 48, id + " world height")
		ok(w.start != null, id + " start marker")
		var st: Vector2 = w.start
		ok(not w.blocks(st.x, st.y, 0.25), id + " start is open")
		eq(w.kind_at(st.x, st.y), "outdoor", id + " outdoors at the start")
		ok(w.spots["safe"].size() >= 3, id + " rest spots as safe spots")
		ok(w.spots["people"].size() >= 4, id + " people spots")
		ok(w.lights.size() >= 3 and w.lights.size() <= 16, id + " lights built")
		for r in def["rest"]:
			ok(not w.blocks(r["cell"][0] + 0.5, r["cell"][1] + 0.5, 0.25), id + " rest spot is standable")
		ok(GameData.unregister_map(id + "_gen_test"), id + " unregister")


func test_generation_time() -> void:
	for id in STAGES:
		_all(id)
		var ms: Array = _ms[id]
		var tot := 0.0
		var worst := 0.0
		for m in ms:
			tot += m
			worst = maxf(worst, m)
		print("gen_road: %s %d seeds, avg %.1f ms, worst %.1f ms" % [id, ms.size(), tot / maxf(1.0, float(ms.size())), worst])
		ok(worst < 600.0, "%s generation stays under 600 ms (worst %.1f)" % [id, worst])
