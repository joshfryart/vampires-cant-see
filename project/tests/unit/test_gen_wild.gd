extends TestCase
## The two outdoor stages after the Hollow (WP13a, core/gen/gen_wild.gd): Bramble Wood (`wood`) and Gallows Moor (`moor`), 50 seeds each against the
## rules in docs/ROGUELIKE.md: outdoor kind, >= 3 covered pockets (>= 2 rest spots) that the sun cannot reach, cover distance, the open-air rule
## (a wall within 6 cells of every walkable cell), caps, doors linked both ways with the neighbouring stages, determinism, generation time.

const SEEDS := 50
const STAGES := ["wood", "moor"]
const OPEN_R := 6.0

static var _defs: Dictionary = {}
static var _ms: Dictionary = {}


func _all(id: String) -> Array:
	if not _defs.has(id):
		var a: Array = []
		var m: Array = []
		for s in range(1, SEEDS + 1):
			var t0 := Time.get_ticks_usec()
			a.append(StageGen.generate(id, s))
			m.append(float(Time.get_ticks_usec() - t0) / 1000.0)
		_defs[id] = a
		_ms[id] = m
	return _defs[id]


func _row(id: String) -> Dictionary:
	return StageGen.stage_row(id)


func _zone(def: Dictionary, name: String) -> Dictionary:
	for z in def["zones"]:
		if z["name"] == name:
			return z
	return {}


func _in_zone(z: Dictionary, c: Array) -> bool:
	return c[0] >= z["x0"] and c[0] <= z["x1"] and c[1] >= z["y0"] and c[1] <= z["y1"]


func _stub(name: String, door_id: String, to_map: String, to_door: String) -> Dictionary:
	return {"name": name, "kind": "outdoor", "floor": "grass", "rows": ["#####", "#@..#", "#..D#", "#####"],
		"doors": [{"id": door_id, "col": 3, "row": 2, "toMap": to_map, "toDoor": to_door, "facing": "w"}]}


## The neighbouring stages as one-door stubs that link back, keyed like the stage defs refer to them.
func _neighbours(id: String, d: Dictionary) -> Dictionary:
	var maps := {d["name"]: d}
	if id == "wood":
		maps["stage:hollow"] = _stub("stage:hollow", "mouth", d["name"], "cave")
		maps["stage:moor"] = _stub("stage:moor", "wood", d["name"], "moor")
	else:
		maps["stage:wood"] = _stub("stage:wood", "moor", d["name"], "wood")
		maps["stage:road"] = _stub("stage:road", "moor", d["name"], "road")
	return maps


func test_rows() -> void:
	var order := TrekFlow.stage_order()
	for id in STAGES:
		var r := _row(id)
		ok(not r.is_empty(), id + " row in stages.json")
		eq(r["generator"], id, id + " generator")
		eq(r["kind"], "outdoor", id + " kind")
		eq(int(r["miles"]), 3, id + " miles")
		eq(String(r["next"]), order[order.find(id) + 1], id + " next stage follows the order list")
		eq(TrekFlow.next_stage_id(id), String(r["next"]), id + " TrekFlow.next_stage_id")
		eq(int(r["index"]), order.find(id) + 1, id + " index")
		ok(TrekFlow.has_generator(id), id + " is generated by TrekFlow")
		eq(String(r["entry"]["toMap"]), "stage:" + String(order[order.find(id) - 1]), id + " entry links to the previous stage")
		eq(String(r["exit"]["toMap"]), "stage:" + String(r["next"]), id + " exit links to the next stage")
		for k in ["preyCount", "lights", "size", "openFraction", "shelter", "caps", "entry", "exit", "materials", "fauna", "ambient"]:
			ok(r.has(k), id + " row key " + k)
		eq(int(r["shelter"]["pockets"]["min"]), 3, id + " min pockets")
		eq(int(r["shelter"]["restSpots"]["min"]), 2, id + " min rest spots")
	near(float(_row("wood")["drainMul"]), 0.9, 1e-9, "wood drainMul")
	near(float(_row("moor")["drainMul"]), 1.0, 1e-9, "moor drainMul")
	eq(String(_row("hollow")["exit"]["toDoor"]), String(_row("wood")["entry"]["doorId"]), "hollow mouth leads to the wood's cave door")
	eq(String(_row("wood")["exit"]["toDoor"]), String(_row("moor")["entry"]["doorId"]), "wood exit leads to the moor's wood door")
	ok(TrekFlow.has_generator("road"), "the road is built (WP13b)")


func test_seeds_validate_and_reach() -> void:
	for id in STAGES:
		var defs := _all(id)
		eq(defs.size(), SEEDS, id + " all seeds generated")
		var row := _row(id)
		for i in defs.size():
			var d: Dictionary = defs[i]
			var tag := "%s seed %d" % [id, i + 1]
			ok(not d.is_empty(), tag + " generated")
			if d.is_empty():
				continue
			var v := StageGen.validate(d)
			ok(v["ok"], tag + " validate: " + str(v["errors"]).left(160))
			var va := WorldValidate.validate_all({"startMap": d["name"], "maps": _neighbours(id, d), "links": []})
			ok(va["ok"], tag + " validate_all with neighbours: " + str(va["errors"]).left(200))
			var rep := StageGen.analyze(d, row)
			ok(rep["ok"], tag + " analyze: " + str(rep["reasons"]))
			ok(rep["exit_reachable"], tag + " exit reachable from the start")
			eq(rep["unreachable"], 0, tag + " no cut-off floor")
			eq(d["rows"].size(), 48, tag + " height")
			eq(String(d["rows"][0]).length(), 64, tag + " width")
			eq(d["stage"], id, tag + " stage id")
			eq(d["name"], id, tag + " map name")
			eq(d["seed"], i + 1, tag + " seed echoed")
			eq(d["kind"], "outdoor", tag + " outdoor map")


func test_doors_both_ways() -> void:
	for id in STAGES:
		var row := _row(id)
		for i in _all(id).size():
			var d: Dictionary = _all(id)[i]
			var tag := "%s seed %d" % [id, i + 1]
			eq(d["doors"].size(), 2, tag + " two doors")
			var entry: Dictionary = d["doors"][0]
			var exit_d: Dictionary = d["doors"][1]
			eq(entry["id"], row["entry"]["doorId"], tag + " entry door id")
			eq(entry["toMap"], row["entry"]["toMap"], tag + " entry toMap")
			eq(entry["toDoor"], row["entry"]["toDoor"], tag + " entry toDoor")
			eq(entry["facing"], "e", tag + " entry faces east")
			eq(exit_d["id"], row["exit"]["doorId"], tag + " exit door id")
			eq(exit_d["toMap"], row["exit"]["toMap"], tag + " exit toMap")
			eq(exit_d["toDoor"], row["exit"]["toDoor"], tag + " exit toDoor")
			eq(exit_d["facing"], "w", tag + " exit faces west")
			eq(String(d["rows"][entry["row"]])[entry["col"]], "D", tag + " entry door cell")
			eq(String(d["rows"][exit_d["row"]])[exit_d["col"]], "D", tag + " exit door cell")
			ok(exit_d["col"] > 48, tag + " exit on the far (east) edge")
			ok(entry["col"] < 8, tag + " entry on the west edge")
			var st: Array = d["start"]["cell"]
			eq(st, d["entry"]["arrival"], tag + " start is the entry door's arrival cell")
			near(float(d["start"]["angle"]), 0.0, 1e-9, tag + " facing east, away from the door")
			eq(String(d["rows"][st[1]])[st[0]], "@", tag + " start marker")
			eq(d["exit"]["door"], exit_d["id"], tag + " exit key")
			eq(d["exit"]["toMap"], exit_d["toMap"], tag + " exit key toMap")
			var w := World.from_def(d)
			var arr: Variant = w.arrival(exit_d["id"])
			ok(arr != null and not w.blocks(arr["x"], arr["y"], 0.25), tag + " exit arrival is open")
			var arr2: Variant = w.arrival(entry["id"])
			ok(arr2 != null and not w.blocks(arr2["x"], arr2["y"], 0.25), tag + " entry arrival is open")


## Pockets: indoor zones inside the outdoor map, every one a rest spot, and the sun's rule (Night: day + outdoor = lost) cannot reach them.
func test_pockets_and_sun() -> void:
	var worst_pockets := 99
	for id in STAGES:
		var row := _row(id)
		var kinds: Array = row["shelter"]["kinds"]
		for i in _all(id).size():
			var d: Dictionary = _all(id)[i]
			var tag := "%s seed %d" % [id, i + 1]
			var world := World.from_def(d)
			worst_pockets = mini(worst_pockets, d["pockets"].size())
			ok(d["pockets"].size() >= 3, tag + " >= 3 covered pockets (%d)" % d["pockets"].size())
			var non_coffin := 0
			var s_count := 0
			for ch in "\n".join(d["rows"]):
				if ch == "S":
					s_count += 1
				elif ch == "C":
					ok(false, tag + " no coffin marker expected")
			for r in d["rest"]:
				if r["kind"] != "coffin":
					non_coffin += 1
				ok(kinds.has(r["kind"]), tag + " rest kind " + String(r["kind"]))
				ok(float(r["safety"]) >= 0.0 and float(r["safety"]) <= 1.0, tag + " safety in 0..1")
				eq(String(d["rows"][r["cell"][1]])[r["cell"][0]], r["marker"], tag + " rest marker on the map")
				eq(world.kind_at(r["cell"][0] + 0.5, r["cell"][1] + 0.5), "indoor", tag + " rest spot is roofed")
			ok(non_coffin >= 2, tag + " >= 2 rest spots")
			eq(s_count, d["rest"].size(), tag + " one S per rest spot")
			var names := {}
			for z in d["zones"]:
				eq(z["kind"], "indoor", tag + " zone kind")
				ok(not names.has(z["name"]), tag + " unique zone " + z["name"])
				names[z["name"]] = true
			var rest_pockets := 0
			for p in d["pockets"]:
				var z := _zone(d, p["zone"])
				ok(not z.is_empty() and z["kind"] == "indoor", tag + " pocket zone " + p["zone"])
				if not z.is_empty():
					ok(_in_zone(z, p["cell"]), tag + " pocket cell inside its zone")
					# every floor cell of the pocket is under cover; the sun's rule leaves the player alive there
					for y in range(z["y0"], z["y1"] + 1):
						for x in range(z["x0"], z["x1"] + 1):
							if ".@CS".contains(String(d["rows"][y])[x]):
								eq(world.kind_at(x + 0.5, y + 0.5), "indoor", tag + " pocket floor is indoor")
				if p["rest"]:
					rest_pockets += 1
			ok(rest_pockets >= 2, tag + " pockets that are rest spots")
			var cov := world
			var pc: Array = d["pockets"][0]["cell"]
			var n1 := Night.create({"nightSec": 480.0})
			n1.status = "day"
			n1.min = Night.NIGHT_MIN
			n1.fired = {"chime": true, "washout": true, "dawn": true}
			var ev1 := n1.update(0.1, {"outdoor": cov.kind_at(pc[0] + 0.5, pc[1] + 0.5) == "outdoor"})
			eq(n1.status, "day", tag + " alive at dawn inside a pocket")
			ok(not ev1.has("lost"), tag + " no sun death in a pocket")
			var st: Array = d["start"]["cell"]
			var n2 := Night.create({"nightSec": 480.0})
			n2.status = "day"
			n2.min = Night.NIGHT_MIN
			n2.fired = {"chime": true, "washout": true, "dawn": true}
			n2.update(0.1, {"outdoor": cov.kind_at(st[0] + 0.5, st[1] + 0.5) == "outdoor"})
			eq(n2.status, "lost", tag + " the open start cell is sunlit")
	print("gen_wild: fewest pockets over %d seeds x 2 stages = %d" % [SEEDS, worst_pockets])


func test_cover_distance_rule() -> void:
	var limit := StageGen.cover_limit()
	for id in STAGES:
		var row := _row(id)
		var target: int = int(row["shelter"]["restTarget"])
		var worst := 0
		for i in _all(id).size():
			var rep := StageGen.analyze(_all(id)[i], row)
			worst = maxi(worst, rep["max_rest_dist"])
			ok(rep["max_rest_dist"] >= 0 and rep["max_rest_dist"] <= limit, "%s seed %d rest within %d cells (got %d)" % [id, i + 1, limit, rep["max_rest_dist"]])
			ok(rep["max_rest_dist"] <= target + 10, "%s seed %d design target %d (got %d)" % [id, i + 1, target, rep["max_rest_dist"]])
		print("gen_wild: %s worst rest distance over %d seeds = %d cells (rule limit %d, design target %d)" % [id, SEEDS, worst, limit, target])


## Open-air rule (docs: wild R = 6): every walkable cell has a wall cell within 6 cells (exact Euclidean check).
func test_open_air_rule() -> void:
	for id in STAGES:
		var worst := 0.0
		for i in _all(id).size():
			var oa := GenWild.open_air_max(_all(id)[i])
			worst = maxf(worst, oa)
			ok(oa <= OPEN_R, "%s seed %d: farthest walkable cell is %.2f from a wall (limit %.1f)" % [id, i + 1, oa, OPEN_R])
		print("gen_wild: %s open-air worst distance over %d seeds = %.2f cells (limit %.1f)" % [id, SEEDS, worst, OPEN_R])
	# the checker itself: a 20 x 20 room has cells 10 from the wall
	var rows: Array = []
	for y in 20:
		rows.append("#".repeat(20) if (y == 0 or y == 19) else "#" + ".".repeat(18) + "#")
	ok(GenWild.open_air_max({"rows": rows}) > 8.0, "open_air_max sees the middle of a big room")


func test_caps_and_fractions() -> void:
	var species := Critters.species_table()
	for id in STAGES:
		var row := _row(id)
		var lo := 1.0
		var hi := 0.0
		for i in _all(id).size():
			var d: Dictionary = _all(id)[i]
			var tag := "%s seed %d" % [id, i + 1]
			var plan := StageGen.plan_from_def(d)
			eq(d["paths"].size(), 0, tag + " no people paths")
			ok(not "\n".join(d["rows"]).contains("P"), tag + " no people spots")
			ok(d["critters"].size() <= 12, tag + " critters <= 12")
			ok(d["critters"].size() >= int(row["preyCount"]["min"]) - 1, tag + " prey count %d" % d["critters"].size())
			var kinds := {}
			for c in d["critters"]:
				ok(species.has(c["species"]), tag + " known species " + str(c["species"]))
				ok(plan.walkable(c["cell"][0], c["cell"][1]), tag + " critter on walkable floor")
				kinds[c["species"]] = int(kinds.get(c["species"], 0)) + 1
			ok(kinds.has(row["fauna"]["small"]) and kinds.has(row["fauna"]["big"]), tag + " both species present " + str(kinds))
			for k in kinds:
				ok(k == row["fauna"]["small"] or k == row["fauna"]["big"], tag + " only this stage's fauna (" + String(k) + ")")
			ok(d["props"].size() <= 60, tag + " props <= 60")
			ok(d["lights"].size() <= 16, tag + " lights <= 16")
			ok(d["lights"].size() >= int(row["lights"]["min"]), tag + " lights >= %d" % int(row["lights"]["min"]))
			ok(d["ambient"].size() <= 24, tag + " ambient anchors <= 24")
			var f: float = StageGen.analyze(d, row)["open_fraction"]
			lo = minf(lo, f)
			hi = maxf(hi, f)
			ok(f >= float(row["openFraction"]["min"]) and f <= float(row["openFraction"]["max"]), tag + " open fraction %.3f" % f)
			var world := World.from_def(d)
			for p in d["props"]:
				ok(["stump", "boulder", "glowworm"].has(p["type"]), tag + " prop type " + String(p["type"]))
				ok(plan.tile(p["col"], p["row"]) == 1, tag + " prop on floor")
			eq(world.kind, "outdoor", tag + " world kind outdoor")
			eq(d["materials"]["#"], "grass", tag + " grass thicket")
		print("gen_wild: %s open fraction over %d seeds %.3f .. %.3f (62x46 interior, water included)" % [id, SEEDS, lo, hi])


func test_wood_features() -> void:
	var row := _row("wood")
	for i in _all("wood").size():
		var d: Dictionary = _all("wood")[i]
		var tag := "wood seed %d" % (i + 1)
		var rows: Array = d["rows"]
		var all_text: String = "\n".join(rows)
		ok(all_text.contains("W"), tag + " trunks")
		ok(d["materials"]["W"] == "wood", tag + " trunk material")
		# the creek runs the whole height; the only rows without water are the fords
		var dry: Array = []
		for y in range(1, rows.size() - 1):
			if not String(rows[y]).contains("~"):
				dry.append(y)
		ok(dry.size() >= 2 and dry.size() <= 4, tag + " ford rows %s" % str(dry))
		var ford_rows := {}
		for k in d["places"]:
			if String(k).begins_with("ford_"):
				ford_rows[int(d["places"][k][1])] = true
				ford_rows[int(d["places"][k][1]) + 1] = true
		for y in dry:
			ok(ford_rows.has(y), tag + " dry row %d is a ford" % y)
		ok(ford_rows.size() >= 4, tag + " two fords")
		# crossable only at fords: close the ford strips (4 columns, both rows) and the exit must be cut off
		var plan := StageGen.plan_from_def(d)
		for k in d["places"]:
			if String(k).begins_with("ford_"):
				var cx: int = int(d["places"][k][0])
				var fy: int = int(d["places"][k][1])
				for y in [fy, fy + 1]:
					for x in range(cx - 1, cx + 3):
						if plan.tiles[y * plan.w + x] == 1:
							plan.tiles[y * plan.w + x] = 2
		var dist := StageGen.bfs(plan, [plan.idx(d["start"]["cell"][0], d["start"]["cell"][1])])
		var arr: Array = d["exit"]["arrival"]
		ok(dist[plan.idx(arr[0], arr[1])] < 0, tag + " without the fords the creek cuts the map in two")
		var kinds := {}
		for a in d["ambient"]:
			kinds[a["kind"]] = int(kinds.get(a["kind"], 0)) + 1
		ok(kinds.get("creek", 0) >= 5 and kinds.get("creek", 0) <= 8, tag + " creek anchors %d" % kinds.get("creek", 0))
		ok(kinds.get("owl", 0) >= 2 and kinds.get("owl", 0) <= 3, tag + " owls")
		ok(kinds.get("wind", 0) >= 2 and kinds.get("wind", 0) <= 3, tag + " wind")
		eq(kinds.get("cricket", 0), 0, tag + " no crickets in the wood")
		for a in d["ambient"]:
			if a["kind"] == "creek":
				eq(String(rows[a["cell"][1]])[a["cell"][0]], "~", tag + " creek anchor sits on water")
		var pk := {}
		for p in d["pockets"]:
			pk[p["kind"]] = true
		ok(pk.has("hollow_tree") or pk.has("burrow"), tag + " pocket kinds " + str(pk.keys()))
		for p in d["pockets"]:
			ok(["hollow_tree", "burrow"].has(p["kind"]), tag + " wood pocket kind " + String(p["kind"]))
		eq(row["fauna"]["big"], "deer", "wood deer")


func test_moor_features() -> void:
	for i in _all("moor").size():
		var d: Dictionary = _all("moor")[i]
		var tag := "moor seed %d" % (i + 1)
		var rows: Array = d["rows"]
		var all_text: String = "\n".join(rows)
		ok(all_text.contains("B"), tag + " cairns")
		ok(all_text.contains("I"), tag + " gibbets")
		ok(all_text.contains("~"), tag + " bog pools")
		eq(d["materials"]["B"], "roughStone", tag + " cairn material")
		var kinds := {}
		for a in d["ambient"]:
			kinds[a["kind"]] = int(kinds.get(a["kind"], 0)) + 1
		ok(kinds.get("cricket", 0) >= 6 and kinds.get("cricket", 0) <= 8, tag + " crickets %d" % kinds.get("cricket", 0))
		ok(kinds.get("wind", 0) >= 3 and kinds.get("wind", 0) <= 4, tag + " wind")
		eq(kinds.get("creek", 0), 0, tag + " no creek on the moor")
		eq(kinds.get("owl", 0), 0, tag + " no owls on the moor")
		ok(kinds.get("ripple", 0) >= 2, tag + " ripples on the pools")
		for a in d["ambient"]:
			if a["kind"] == "ripple":
				eq(String(rows[a["cell"][1]])[a["cell"][0]], "~", tag + " ripple anchor sits on water")
		var wolves := 0
		var hares := 0
		var st: Array = d["start"]["cell"]
		for c in d["critters"]:
			if c["species"] == "wolf":
				wolves += 1
				ok(Vector2(c["cell"][0], c["cell"][1]).distance_to(Vector2(st[0], st[1])) >= 15.0, tag + " wolves start far from the player")
			elif c["species"] == "hare":
				hares += 1
		ok(wolves >= 2 and wolves <= 3, tag + " wolves %d" % wolves)
		ok(hares >= 4, tag + " hares %d" % hares)
		for p in d["pockets"]:
			ok(["barrow", "peat_cut"].has(p["kind"]), tag + " moor pocket kind " + String(p["kind"]))


## The moor's crickets go silent near the player (Ambient `quiet`), the wood's creek does not.
func test_crickets_go_quiet() -> void:
	var d: Dictionary = _all("moor")[0]
	var world := World.from_def(d)
	var plan := StageGen.plan_from_def(d)
	var pc := Vector2i(-1, -1)
	for y in range(8, 40):
		for x in range(10, 50):
			if plan.walkable(x, y) and plan.walkable(x + 6, y):
				pc = Vector2i(x, y)
	ok(pc.x >= 0, "found two floor cells 6 apart")
	var near_p := Vector2(pc.x + 0.5, pc.y + 0.5)
	var amb_near := Ambient.new([{"cell": [pc.x + 2, pc.y], "kind": "cricket"}], {})
	var amb_far := Ambient.new([{"cell": [pc.x + 6, pc.y], "kind": "cricket"}], {})
	var s1 := Sonar.create()
	var s2 := Sonar.create()
	var r1 := Rng.new(3)
	var r2 := Rng.new(3)
	var t := 0.0
	for i in 1200:
		t += 0.05
		amb_near.step(world, s1, near_p, 0.05, r1, t)
		amb_far.step(world, s2, near_p, 0.05, r2, t)
	eq(amb_near.emitted, 0, "a cricket 2 cells from the player stays silent")
	ok(amb_far.emitted > 5, "a cricket 6 cells away chirps (%d)" % amb_far.emitted)
	eq(Ambient.load_kinds()["cricket"]["quiet"], 3.0, "cricket quiet radius")


func test_deterministic_and_distinct() -> void:
	for id in STAGES:
		var defs := _all(id)
		for s in [1, 17, 50]:
			var again := StageGen.generate(id, s)
			ok(again == defs[s - 1], "%s seed %d regenerates identically" % [id, s])
		var seen := {}
		for d in defs:
			seen[str(d["rows"]).hash()] = true
		eq(seen.size(), defs.size(), id + " all 50 seeds give different maps")
		var other := StageGen.generate(id, 1000003)
		ok(other["rows"] != defs[0]["rows"], id + " far seed differs")
	ok(_all("wood")[0]["rows"] != _all("moor")[0]["rows"], "the two stages differ")


func test_register_and_build_world() -> void:
	for id in STAGES:
		var d: Dictionary = _all(id)[2]
		GameData.register_map(id + "_gen_test", d)
		var def: Dictionary = GameData.map_def(id + "_gen_test")
		var w := World.from_def(def)
		eq(w.width, 64, id + " world width")
		eq(w.height, 48, id + " world height")
		ok(w.start != null, id + " start marker")
		var st: Vector2 = w.start
		ok(not w.blocks(st.x, st.y, 0.25), id + " start is open")
		eq(w.kind_at(st.x, st.y), "outdoor", id + " outdoors at the start")
		ok(w.spots["safe"].size() >= 3, id + " rest spots as safe spots")
		ok(w.has_water, id + " water tile present")
		ok(w.lights.size() >= 2 and w.lights.size() <= 16, id + " lights built")
		eq(w.mat_table["#"], "grass", id + " thicket material")
		for r in def["rest"]:
			ok(not w.blocks(r["cell"][0] + 0.5, r["cell"][1] + 0.5, 0.25), id + " rest spot is standable")
		ok(GameData.unregister_map(id + "_gen_test"), id + " unregister")


func test_generation_time() -> void:
	for id in STAGES:
		_all(id)
		var ms: Array = _ms[id]
		var tot := 0.0
		var worst := 0.0
		for m in ms:
			tot += m
			worst = maxf(worst, m)
		print("gen_wild: %s %d seeds, avg %.1f ms, worst %.1f ms" % [id, ms.size(), tot / maxf(1.0, float(ms.size())), worst])
		ok(worst < 600.0, "%s generation stays under 600 ms (worst %.1f)" % [id, worst])
